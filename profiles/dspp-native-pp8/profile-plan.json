  "long_history_if_needed": {
    "condition": "end-to-end inputs contain sequences longer than 32768",
    "sequence_lengths": [
      65536,
      98304,
      131072
    ],
    "capacities": [
      4096,
      8192
    ],
    "query": [
      "capacity",
      "capacity//2+1"
    ],
    "history": "floor((sequence_length-query)/capacity)*capacity",
    "operations": [
      "F",
      "B_fused",
      "D",
      "H"
    ],
    "reuse": "Check archived native c2048 isolated long-history records first; do not repeat them by default."
  },
  "p2p": {
    "action": "reuse",
    "directions": 14,
    "bytes": [
      8388608,
      16777216,
      25165824,
      33554432
    ],
    "overlap": [
      "isolated",
      "compute"
    ],
    "remeasure_only_if": "physical peer placement, transport, communication overlap policy or message-size domain changes"
  },
  "end_to_end": {
    "warmup": 5,
    "timed_updates": 20,
    "modes": [
      "fixed2048 template",
      "fixed2048 tail-B",
      "adaptive template",
      "adaptive tail-B"
    ],
    "dataset": "same batches and target model in all modes",
    "instrumentation": "tools/benchmark_dspp.py only; no per-task events or owner recording",
    "note": "Prediction/memory checks are calibration; compare throughput separately. Do not run a4-a6 frozen wrappers."
  },
  "integration": {
    "raw_format": "dspp-stage-calibration-v2 records: stage, chunk, operation, signature, duration_ms, context",
    "source_addition": "Append raw or compact sources to sources.json.compute; local measurements to local_compute. Exporter supports .json and .json.gz. F_after_dx is recorded separately, not merged into F.",
    "priority": "Target PP8 measurements supersede local transfers automatically when exact signatures match.",
    "runner_note": "Historical run_window.py uses deleted timeline/owner flags. Port measurement only into an offline entry before the GPU window; never restore those flags to production schedules."
  }

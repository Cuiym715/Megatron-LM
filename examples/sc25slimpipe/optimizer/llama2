# Llama-2: Page 5, https://arxiv.org/pdf/2307.09288v2.pdf

if [ "$NUM_LAYERS" -le 40 ]; then
    LR=3e-4
    MIN_LR=3e-5
else
    LR=1.5e-4
    MIN_LR=1.5e-5
fi
LR_DECAY_ITERS=$(( (2 * 2**40) / (4 * 2**20) ))  # 2T / 4M

OPTIMIZER_ARGS="
    --optimizer adam \
    --adam-beta1 0.9 \
    --adam-beta2 0.95 \
    --adam-eps 1e-5 \
    --lr $LR \
    --lr-decay-iters $LR_DECAY_ITERS \
    --lr-decay-style cosine \
    --lr-warmup-iters $((LR_DECAY_ITERS * 3/100)) \
    --min-lr $MIN_LR \
    --weight-decay 0.1 \
    --clip-grad 1.0 \
"

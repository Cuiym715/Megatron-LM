diff --git a/examples/gpt3/train_llama_7b_distributed.sh b/examples/gpt3/train_llama_7b_distributed.sh
new file mode 100755
index 00000000..77cb43b2
--- /dev/null
+++ b/examples/gpt3/train_llama_7b_distributed.sh
@@ -0,0 +1,123 @@
+#!/bin/bash
+
+# Runs the "Llama-7B" parameter model
+
+export CUDA_DEVICE_MAX_CONNECTIONS=1
+
+GPUS_PER_NODE=8
+# Change for multinode config
+MASTER_ADDR=localhost
+MASTER_PORT=6000
+NUM_NODES=1
+NODE_RANK=0
+WORLD_SIZE=$(($GPUS_PER_NODE*$NUM_NODES))
+
+DIR=`pwd`
+DATETIME=`date +'date_%y-%m-%d_time_%H-%M-%S'`
+
+CHECKPOINT_PATH="$DIR/save"
+TENSORBOARD_LOGS_PATH="$DIR/local"
+DATA_PATH="/share/yuantailing/Datasets/sample_enwiki_32005/my-llama_text_document"
+TOKENIZER="/share/zhangwei/Llama-2-7b-hf/tokenizer.model"
+
+DISTRIBUTED_ARGS=(
+    --nproc_per_node $GPUS_PER_NODE
+    --nnodes $NUM_NODES
+    --master_addr $MASTER_ADDR
+    --master_port $MASTER_PORT
+)
+
+SEQ_LENGTH_BASE=88
+SEQ_LENGTH=$(($SEQ_LENGTH_BASE*1024))
+
+GPT_MODEL_ARGS=(
+    --num-layers 32
+    --hidden-size 4096
+    --ffn-hidden-size 11008
+    --num-attention-heads 32
+    --seq-length $SEQ_LENGTH
+    --max-position-embeddings $SEQ_LENGTH
+    --position-embedding-type rope
+    --swiglu
+    --normalization RMSNorm
+    --disable-bias-linear
+    --untie-embeddings-and-output-weights
+    --hidden-dropout 0.
+    --attention-dropout 0.
+    --accumulate-allreduce-grads-in-fp32
+    --seed 9527
+)
+
+MICRO_BATCH_SIZE=1
+GLOBAL_BATCH_SIZE=8
+
+LR=3e-4
+MIN_LR=3e-5
+LR_DECAY_ITERS=$(( 2**40 / (4 * 2**20) ))  # 1T / 4M
+
+TRAINING_ARGS=(
+    --micro-batch-size $MICRO_BATCH_SIZE
+    --global-batch-size $GLOBAL_BATCH_SIZE
+    --train-iters 1000
+    --weight-decay 0.1
+    --optimizer adam
+    --adam-beta1 0.9
+    --adam-beta2 0.95
+    --adam-eps 1e-5
+    --init-method-std 0.006
+    --clip-grad 1.0
+    --bf16
+    --lr $LR
+    --min-lr $MIN_LR
+    --lr-decay-style cosine
+    --min-lr 6.0e-6
+    --lr-warmup-iters 2000
+    --lr-decay-iters $LR_DECAY_ITERS
+)
+
+NUM_VIRTUAL_STAGES=1
+    # --num-virtual-stages-per-pipeline-rank $NUM_VIRTUAL_STAGES
+MODEL_PARALLEL_ARGS=(
+	--tensor-model-parallel-size 1
+    --context-parallel-size 1
+	--pipeline-model-parallel-size 8
+)
+
+DATA_ARGS=(
+    --data-path $DATA_PATH
+    --tokenizer-type SentencePieceTokenizer
+    --tokenizer-model $TOKENIZER
+    --split 100,0,0
+    --no-create-attention-mask-in-dataloader
+)
+
+PERFORMANCE_ARGS=(
+    --recompute-granularity full
+    --recompute-method uniform
+    --recompute-num-layers 1
+    --use-flash-attn
+)
+
+LOG_INTERVAL=2
+
+EVAL_AND_LOGGING_ARGS=(
+    --log-interval $LOG_INTERVAL
+    --eval-iters 0
+    --log-throughput
+    --tensorboard-dir $TENSORBOARD_LOGS_PATH
+    --wandb-project megatron
+    --wandb-exp-name 1f1b-${GLOBAL_BATCH_SIZE}-${SEQ_LENGTH_BASE}k
+    --wandb-save-dir wandb
+)
+
+LOG_DIR=$DIR/logs
+LOG_FILE=$LOG_DIR/${DATETIME}-1f1b-${GLOBAL_BATCH_SIZE}-${SEQ_LENGTH_BASE}k
+exec &> >(tee "$LOG_FILE")
+
+torchrun ${DISTRIBUTED_ARGS[@]} pretrain_gpt.py \
+    ${GPT_MODEL_ARGS[@]} \
+    ${TRAINING_ARGS[@]} \
+    ${MODEL_PARALLEL_ARGS[@]} \
+    ${DATA_ARGS[@]} \
+    ${PERFORMANCE_ARGS[@]} \
+    ${EVAL_AND_LOGGING_ARGS[@]}
-- 
2.25.1


